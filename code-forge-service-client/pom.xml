<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xly</groupId>
        <artifactId>code-forge</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>code-forge-service-client</artifactId>
    <name>code-forge-service-client</name>
    <description>服务间调用客户端：HttpExchange 接口（RestClient + 负载均衡），是库不是服务（无启动类、无配置文件）</description>

    <dependencies>
        <!--
          HttpExchange 客户端走服务发现：RestClient 的 URL 以 http://<服务名> 开头，
          由 spring-cloud-starter-loadbalancer 提供的 @LoadBalanced 拦截器解析为实例。
          放进本库，任意消费方无需各自重复引入。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- @GetMapping / @PostMapping / @RequestParam -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- @AutoConfiguration（ServiceClientAutoConfiguration 经 AutoConfiguration.imports 注册） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- BeanUtils -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
        </dependency>
        <!-- UserFeignClient#getLoginUser 的入参 HttpServletRequest -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.xly</groupId>
            <artifactId>code-forge-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xly</groupId>
            <artifactId>code-forge-model</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
