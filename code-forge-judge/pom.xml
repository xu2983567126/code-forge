<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xly</groupId>
        <artifactId>code-forge</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>code-forge-judge</artifactId>
    <name>code-forge-judge</name>
    <description>判题服务：代码沙箱调度 / 判题策略（8085，不连数据库）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- RemoteSandbox 用 hutool 发 HTTP -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- RemoteSandbox 的 HMAC-SHA256 签名 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.xly</groupId>
            <artifactId>code-forge-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xly</groupId>
            <artifactId>code-forge-model</artifactId>
        </dependency>
        <!-- 需要调 question-service（取题目）与 submission-service（取提交记录、回写判题结果） -->
        <dependency>
            <groupId>com.xly</groupId>
            <artifactId>code-forge-service-client</artifactId>
        </dependency>
        <!-- 刻意不引入 mybatis-plus-boot-starter：本服务不连数据库 -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 聚合文档：暴露本服务 /v3/api-docs 供网关 nextdoc4j 聚合（不带 UI，更轻） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        </dependency>
        <!-- ===== 异步判题（M7-1）：消费 judge.queue。与 submission 侧同为 amqp starter，
             两侧自动配置一致（RabbitTemplate / RabbitAdmin / 监听容器工厂）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- ===== P0 可观测（M7）：Micrometer 指标 + actuator 暴露 =====
             暴露 /actuator/metrics 与 /actuator/prometheus 供 Grafana 抓取。
             micrometer-core 由 actuator 间接引入；prometheus 注册表单独引入以便输出 scrape 格式。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
