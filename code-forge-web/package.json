{
  "name": "code-forge-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "merge:openapi": "node scripts/merge-openapi.mjs",
    "clean:api": "node -e \"require('node:fs').rmSync('generated',{recursive:true,force:true})\"",
    "generate:api": "npm run merge:openapi && openapi-ts && npm run check:generated",
    "generate:api:force": "npm run clean:api && npm run merge:openapi && openapi-ts && npm run check:generated",
    "check:generated": "node scripts/check-generated-client.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hey-api/client-axios": "^0.9.1",
    "@mdit/plugin-katex": "^1.1.1",
    "@monaco-editor/loader": "^1.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-virtual": "^3.13.39",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/moment": "^2.11.29",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.0",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.2",
    "marked": "^18.0.1",
    "moment": "^2.30.1",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.2.6"
  }
}
